generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(cuid())
  clerkId                    String?                     @unique
  email                      String                      @unique
  name                       String?
  phone                      String?
  timezone                   String                      @default("Asia/Kolkata")
  locale                     String                      @default("en-IN")
  dateFormat                 String                      @default("dd MMM yyyy")
  themePreference            String                      @default("dark")
  densityPreference          String                      @default("comfortable")
  defaultMessageLanguage     String                      @default("en")
  defaultLandingPage         String                      @default("org")
  createdAt                  DateTime                    @default(now())
  organizations              Organization[]
  staff                      Staff[]
  auditLogs                  AuditLog[]
  importSessionsUploaded     ImportSession[]             @relation("ImportSessionUploadedBy")
  importCommits              ImportCommit[]              @relation("ImportCommitCommittedBy")
  importPlansCompiled        ImportPlan[]                @relation("ImportPlanCompiledBy")
  importRunsRequested        ImportRun[]                 @relation("ImportRunRequestedBy")
  importRunsCancelled        ImportRun[]                 @relation("ImportRunCancelledBy")
  importRecipesCreated       ImportRecipe[]              @relation("ImportRecipeCreatedBy")
  paymentResolutionEvents    PaymentResolutionEvent[]    @relation("PaymentResolutionEventActor")
  whatsAppSendersConnected   WhatsAppSender[]            @relation("WhatsAppSenderConnectedBy")
  whatsAppConnectionIntents  WhatsAppConnectionIntent[]  @relation("WhatsAppConnectionIntentActor")
  whatsAppConsentsRecorded   WhatsAppConsent[]           @relation("WhatsAppConsentRecordedBy")
  whatsAppConsentEvents      WhatsAppConsentEvent[]      @relation("WhatsAppConsentEventActor")
  whatsAppRecipientsCreated  WhatsAppStudentRecipient[]  @relation("WhatsAppStudentRecipientCreatedBy")
  whatsAppAutomationsEnabled BranchWhatsAppSettings[]    @relation("BranchWhatsAppAutomationEnabledBy")
  whatsAppManualSendRequests WhatsAppManualSendRequest[] @relation("WhatsAppManualSendRequestActor")
  whatsAppMessagesCreated    WhatsAppMessage[]           @relation("WhatsAppMessageCreatedBy")
  whatsAppAuditEvents        WhatsAppAuditEvent[]        @relation("WhatsAppAuditEventActor")
  ownerTrialGrant            OwnerTrialGrant?
}

model Organization {
  id                             String                            @id @default(cuid())
  name                           String
  ownerId                        String
  businessType                   String?
  legalName                      String?
  contactEmail                   String?
  contactPhone                   String?
  address                        String?
  timezone                       String                            @default("Asia/Kolkata")
  currency                       String                            @default("INR")
  weekStartsOn                   Int                               @default(1)
  paymentGraceDays               Int                               @default(0)
  selectedPostTrialPlan          SaasPlan?
  billingModelVersion            BillingModelVersion               @default(LEGACY)
  billingMutationSequence        Int                               @default(0)
  billingMutationLeaseToken      String?
  billingMutationLeaseUntil      DateTime?
  createdAt                      DateTime                          @default(now())
  branches                       Branch[]
  subscription                   OrganizationSubscription?         @relation("OrganizationCurrentSubscription")
  pendingSubscriptionReplacement OrganizationSubscription?         @relation("OrganizationPendingSubscriptionReplacement")
  subscriptions                  OrganizationSubscription[]        @relation("OrganizationSubscriptionOwner")
  subscriptionHistory            OrganizationSubscriptionHistory[]
  razorpayWebhookEvents          RazorpayWebhookEvent[]
  ownerTrialGrant                OwnerTrialGrant?
  billingChanges                 OrganizationBillingChange[]
  offerGrants                    OrganizationOfferGrant[]
  subscriptionInvoices           OrganizationSubscriptionInvoice[]
  importRecipes                  ImportRecipe[]
  whatsAppSenders                WhatsAppSender[]
  whatsAppConnectionIntents      WhatsAppConnectionIntent[]
  branchWhatsAppSettings         BranchWhatsAppSettings[]
  whatsAppStudentRecipients      WhatsAppStudentRecipient[]
  whatsAppAutomationRules        WhatsAppAutomationRule[]
  whatsAppManualSendRequests     WhatsAppManualSendRequest[]
  whatsAppMessages               WhatsAppMessage[]
  whatsAppWebhookReceipts        WhatsAppWebhookReceipt[]
  whatsAppAuditEvents            WhatsAppAuditEvent[]
  owner                          User                              @relation(fields: [ownerId], references: [id])
}

model Branch {
  id                         String                      @id @default(cuid())
  organizationId             String
  name                       String
  city                       String?
  address                    String?
  contactPhone               String?
  openingTime                String?
  closingTime                String?
  defaultFee                 Int?                        @default(0)
  defaultAdmissionFee        Int?                        @default(0)
  defaultMessageLanguage     String                      @default("en")
  reminderTone               String                      @default("polite")
  aiEnabled                  Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  lastDataChange             DateTime                    @default(now())
  aiLastCalledAt             DateTime?
  aiStatus                   BranchAIStatus              @default(IDLE)
  billingStatus              BranchBillingStatus         @default(ACTIVE)
  billingActivatedAt         DateTime?
  billingArchivedAt          DateTime?
  organization               Organization                @relation(fields: [organizationId], references: [id])
  aiReports                  BranchAIReport[]
  messageDrafts              MessageDraft[]
  multiShifts                MultiShift[]
  payments                   Payment[]
  paymentResolutionEvents    PaymentResolutionEvent[]
  seats                      Seat[]
  shifts                     Shift[]
  staff                      Staff[]
  staffInvites               StaffInvite[]
  students                   Student[]
  auditLogs                  AuditLog[]
  importSessions             ImportSession[]
  importRecipes              ImportRecipe[]
  importRuns                 ImportRun[]
  billingChanges             OrganizationBillingChange[]
  whatsAppSettings           BranchWhatsAppSettings?
  whatsAppStudentRecipients  WhatsAppStudentRecipient[]
  whatsAppAutomationRules    WhatsAppAutomationRule[]
  whatsAppManualSendRequests WhatsAppManualSendRequest[]
  whatsAppMessages           WhatsAppMessage[]
  whatsAppAuditEvents        WhatsAppAuditEvent[]
}

model Student {
  id                    String                     @id @default(cuid())
  branchId              String
  name                  String
  phone                 String?
  status                StudentStatus              @default(ACTIVE)
  enrollmentSource      StudentEnrollmentSource    @default(LEGACY)
  joinedAt              DateTime                   @default(now())
  billingStartAt        DateTime?
  monthlyFee            Int                        @default(0)
  feeLinkedShiftId      String?
  feeLinkedMultiShiftId String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  messageDrafts         MessageDraft[]
  payments              Payment[]
  seatAllocations       SeatAllocation[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppRecipients    WhatsAppStudentRecipient[]
  branch                Branch                     @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([branchId, billingStartAt])
  @@index([feeLinkedShiftId])
  @@index([feeLinkedMultiShiftId])
}

model Seat {
  id              String           @id @default(cuid())
  branchId        String
  label           String
  createdAt       DateTime         @default(now())
  branch          Branch           @relation(fields: [branchId], references: [id])
  seatAllocations SeatAllocation[]

  @@unique([branchId, label])
  @@index([branchId])
}

model Shift {
  id                   String                @id @default(cuid())
  branchId             String
  name                 String
  startTime            String?
  endTime              String?
  price                Int                   @default(0)
  isReserved           Boolean               @default(false)
  status               ShiftStatus           @default(ACTIVE)
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  seatAllocations      SeatAllocation[]
  multiShiftComponents MultiShiftComponent[]
  branch               Branch                @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([branchId, status])
}

model MultiShift {
  id          String                @id @default(cuid())
  branchId    String
  name        String
  price       Int                   @default(0)
  createdAt   DateTime              @default(now())
  branch      Branch                @relation(fields: [branchId], references: [id])
  components  MultiShiftComponent[]
  allocations SeatAllocation[]

  @@unique([branchId, name])
  @@index([branchId])
}

model MultiShiftComponent {
  id           String     @id @default(cuid())
  multiShiftId String
  shiftId      String
  order        Int        @default(0)
  multiShift   MultiShift @relation(fields: [multiShiftId], references: [id], onDelete: Cascade)
  shift        Shift      @relation(fields: [shiftId], references: [id])

  @@unique([multiShiftId, shiftId])
}

model SeatAllocation {
  id           String      @id @default(cuid())
  seatId       String
  studentId    String
  shiftId      String
  multiShiftId String?
  startDate    DateTime    @default(now())
  endDate      DateTime?
  seat         Seat        @relation(fields: [seatId], references: [id])
  shift        Shift       @relation(fields: [shiftId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
  multiShift   MultiShift? @relation(fields: [multiShiftId], references: [id])

  @@index([seatId, shiftId])
  @@index([studentId])
  @@index([multiShiftId])
}

model Payment {
  id                     String                   @id @default(cuid())
  branchId               String
  studentId              String
  periodStart            DateTime
  periodEnd              DateTime
  dueDate                DateTime
  amount                 Int
  status                 PaymentStatus            @default(DUE)
  paidAt                 DateTime?
  paymentMethod          PaymentMethod?
  referenceId            String?
  type                   PaymentType              @default(MONTHLY)
  createdAt              DateTime                 @default(now())
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  student                Student                  @relation(fields: [studentId], references: [id])
  resolutionEvents       PaymentResolutionEvent[]
  whatsAppMessages       WhatsAppMessage[]
  whatsAppMessageSources WhatsAppMessagePayment[]

  @@unique([studentId, type, periodStart], map: "Payment_studentId_type_periodStart_key")
  @@index([branchId, dueDate])
}

model PaymentResolutionEvent {
  id               String                       @id @default(cuid())
  paymentId        String
  branchId         String
  actorUserId      String?
  source           PaymentResolutionEventSource
  fromStatus       PaymentStatus
  toStatus         PaymentStatus
  amount           Int
  paymentType      PaymentType
  periodStart      DateTime
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  referenceId      String?
  details          Json?
  occurredAt       DateTime                     @default(now())
  payment          Payment                      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  branch           Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor            User?                        @relation("PaymentResolutionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  whatsAppMessages WhatsAppMessage[]

  @@index([paymentId, occurredAt, id])
  @@index([branchId, occurredAt, id])
}

model Staff {
  id                  String                    @id @default(cuid())
  userId              String
  branchId            String
  role                StaffRole
  createdAt           DateTime                  @default(now())
  branch              Branch                    @relation(fields: [branchId], references: [id])
  user                User                      @relation(fields: [userId], references: [id])
  permissionOverrides StaffPermissionOverride[]

  @@unique([userId, branchId])
  @@index([branchId])
}

model StaffPermissionOverride {
  id        String                @id @default(cuid())
  staffId   String
  action    StaffPermissionAction
  allowed   Boolean
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  staff     Staff                 @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, action])
  @@index([staffId])
}

model StaffInvite {
  id         String    @id @default(cuid())
  branchId   String
  role       StaffRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  branch     Branch    @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([expiresAt])
}

model BranchAIReport {
  id        String   @id @default(cuid())
  branchId  String
  data      Json
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
}

model MessageDraft {
  id        String   @id @default(cuid())
  branchId  String
  studentId String?
  action    String
  language  String   @default("en")
  message   String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])

  @@index([branchId, studentId])
}

model WhatsAppSender {
  id                           String                                @id @default(cuid())
  organizationId               String
  provider                     WhatsAppProvider
  providerMode                 WhatsAppProviderMode
  providerBusinessId           String?
  wabaId                       String
  phoneNumberId                String
  displayPhoneNumber           String
  verifiedName                 String?
  qualityRating                String?
  accountMode                  String?
  status                       WhatsAppSenderStatus                  @default(PENDING)
  phoneRegisteredAt            DateTime?
  webhookSubscribedAt          DateTime?
  connectedByUserId            String?
  connectedAt                  DateTime?
  disconnectedAt               DateTime?
  lastSyncedAt                 DateTime?
  lastTemplateSyncAt           DateTime?
  lastHealthCheckAt            DateTime?
  lastErrorCode                String?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  organization                 Organization                          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectedBy                  User?                                 @relation("WhatsAppSenderConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  branchSettings               BranchWhatsAppSettings[]
  templates                    WhatsAppTemplate[]
  managedTemplateProvisionings WhatsAppManagedTemplateProvisioning[]
  templateBindings             WhatsAppTemplateBinding[]
  consents                     WhatsAppConsent[]
  consentEvents                WhatsAppConsentEvent[]
  studentRecipients            WhatsAppStudentRecipient[]
  messages                     WhatsAppMessage[]
  messageEvents                WhatsAppMessageEvent[]
  webhookReceipts              WhatsAppWebhookReceipt[]
  auditEvents                  WhatsAppAuditEvent[]

  @@unique([provider, providerMode, phoneNumberId])
  @@index([organizationId, status])
  @@index([provider, providerMode, wabaId])
}

model WhatsAppConnectionIntent {
  id                 String                         @id @default(cuid())
  organizationId     String
  actorUserId        String
  providerMode       WhatsAppProviderMode
  stateHash          String                         @unique
  status             WhatsAppConnectionIntentStatus @default(CREATED)
  leaseToken         String?                        @unique
  leaseUntil         DateTime?
  attemptCount       Int                            @default(0)
  providerBusinessId String?
  wabaId             String?
  phoneNumberId      String?
  expiresAt          DateTime
  consumedAt         DateTime?
  lastErrorCode      String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor              User                           @relation("WhatsAppConnectionIntentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([actorUserId, status, expiresAt])
}

model BranchWhatsAppSettings {
  branchId                               String          @id
  organizationId                         String
  senderId                               String?
  enabled                                Boolean         @default(false)
  defaultLanguage                        String          @default("en")
  defaultTone                            String          @default("polite")
  monthlyBudgetMinor                     Int?
  sendTimeLocal                          String          @default("10:00")
  dailyAutomaticMessageLimit             Int             @default(50)
  maxAutomaticCollectionMessagesPerCycle Int             @default(4)
  automationEnabledAt                    DateTime?
  automationEnabledByUserId              String?
  configurationRevision                  Int             @default(1)
  plannerLeaseToken                      String?         @unique
  plannerLeaseUntil                      DateTime?
  lastPlannedAt                          DateTime?
  plannerRecipientCursorPhoneE164        String?
  plannerCorrectionCursorAt              DateTime?
  plannerCorrectionCursorId              String?
  plannerPaidCursorAt                    DateTime?
  plannerPaidCursorId                    String?
  lastPlannerErrorCode                   String?
  createdAt                              DateTime        @default(now())
  updatedAt                              DateTime        @updatedAt
  branch                                 Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organization                           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sender                                 WhatsAppSender? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  automationEnabledBy                    User?           @relation("BranchWhatsAppAutomationEnabledBy", fields: [automationEnabledByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([senderId])
  @@index([enabled, automationEnabledAt, plannerLeaseUntil])
}

model WhatsAppTemplate {
  id                 String                         @id @default(cuid())
  senderId           String
  providerTemplateId String
  name               String
  language           String
  category           WhatsAppTemplateCategory
  providerStatus     WhatsAppTemplateProviderStatus
  version            Int                            @default(1)
  components         Json
  componentHash      String
  lastSyncedAt       DateTime
  staleAt            DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  sender             WhatsAppSender                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  messages           WhatsAppMessage[]
  binding            WhatsAppTemplateBinding?

  @@unique([senderId, providerTemplateId])
  @@unique([senderId, name, language])
  @@index([senderId, category, providerStatus])
}

model WhatsAppConsent {
  id                String                     @id @default(cuid())
  senderId          String
  phoneE164         String
  consentType       WhatsAppConsentType
  status            WhatsAppConsentStatus      @default(UNKNOWN)
  source            WhatsAppConsentSource
  policyVersion     String?
  grantedAt         DateTime?
  revokedAt         DateTime?
  recordedByUserId  String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sender            WhatsAppSender             @relation(fields: [senderId], references: [id], onDelete: Restrict)
  recordedBy        User?                      @relation("WhatsAppConsentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  events            WhatsAppConsentEvent[]
  studentRecipients WhatsAppStudentRecipient[]

  @@unique([senderId, phoneE164, consentType])
}

model WhatsAppConsentEvent {
  id             String                @id @default(cuid())
  consentId      String
  senderId       String
  phoneE164      String
  consentType    WhatsAppConsentType
  actorUserId    String?
  previousStatus WhatsAppConsentStatus
  nextStatus     WhatsAppConsentStatus
  source         WhatsAppConsentSource
  policyVersion  String?
  details        Json?
  occurredAt     DateTime              @default(now())
  consent        WhatsAppConsent       @relation(fields: [consentId], references: [id], onDelete: Restrict)
  sender         WhatsAppSender        @relation(fields: [senderId], references: [id], onDelete: Restrict)
  actor          User?                 @relation("WhatsAppConsentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([consentId, occurredAt, id])
  @@index([senderId, occurredAt, id])
}

model WhatsAppStudentRecipient {
  id              String                         @id @default(cuid())
  organizationId  String
  branchId        String
  studentId       String
  senderId        String
  consentId       String
  phoneE164       String
  relationship    WhatsAppRecipientRelationship
  status          WhatsAppStudentRecipientStatus @default(ACTIVE)
  verifiedAt      DateTime
  staleAt         DateTime?
  disabledAt      DateTime?
  createdByUserId String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  student         Student                        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sender          WhatsAppSender                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  consent         WhatsAppConsent                @relation(fields: [consentId], references: [id], onDelete: Restrict)
  createdBy       User?                          @relation("WhatsAppStudentRecipientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([studentId, senderId])
  @@index([branchId, status])
  @@index([senderId, phoneE164, status])
  @@index([consentId])
}

model WhatsAppManagedTemplateProvisioning {
  id                   String                                    @id @default(cuid())
  senderId             String
  managedKey           WhatsAppManagedTemplateKey
  language             String
  catalogVersion       Int
  catalogHash          String
  providerTemplateName String
  providerTemplateId   String?
  status               WhatsAppManagedTemplateProvisioningStatus @default(PENDING)
  attemptCount         Int                                       @default(0)
  leaseToken           String?                                   @unique
  leaseUntil           DateTime?
  lastAttemptAt        DateTime?
  lastErrorCode        String?
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt
  sender               WhatsAppSender                            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  binding              WhatsAppTemplateBinding?

  @@unique([senderId, managedKey, language, catalogVersion])
  @@unique([senderId, providerTemplateName])
  @@index([senderId, status])
}

model WhatsAppTemplateBinding {
  id             String                              @id @default(cuid())
  senderId       String
  templateId     String                              @unique
  provisioningId String                              @unique
  managedKey     WhatsAppManagedTemplateKey
  language       String
  catalogVersion Int
  catalogHash    String
  active         Boolean                             @default(false)
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  sender         WhatsAppSender                      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  template       WhatsAppTemplate                    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  provisioning   WhatsAppManagedTemplateProvisioning @relation(fields: [provisioningId], references: [id], onDelete: Restrict)
  messages       WhatsAppMessage[]

  @@unique([senderId, managedKey, language])
  @@index([senderId, active])
}

model WhatsAppAutomationRule {
  id             String                  @id @default(cuid())
  organizationId String
  branchId       String
  stage          WhatsAppAutomationStage
  enabled        Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, stage])
  @@index([organizationId, enabled])
  @@index([branchId, enabled])
}

model WhatsAppManualSendRequest {
  id                     String                          @id @default(cuid())
  organizationId         String
  branchId               String
  actorUserId            String
  idempotencyKey         String
  requestHash            String
  status                 WhatsAppManualSendRequestStatus @default(PROCESSING)
  selectedPaymentCount   Int                             @default(0)
  eligibleRecipientCount Int                             @default(0)
  queuedMessageCount     Int                             @default(0)
  suppressedCount        Int                             @default(0)
  estimatedCostMicros    BigInt                          @default(0)
  createdAt              DateTime                        @default(now())
  completedAt            DateTime?
  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                 Branch                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor                  User                            @relation("WhatsAppManualSendRequestActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  messages               WhatsAppMessage[]

  @@unique([branchId, idempotencyKey])
  @@index([branchId, createdAt])
  @@index([actorUserId, createdAt])
}

model WhatsAppMessage {
  id                       String                      @id @default(cuid())
  organizationId           String
  branchId                 String?
  senderId                 String
  studentId                String?
  paymentId                String?
  paymentResolutionEventId String?
  templateId               String?
  templateBindingId        String?
  manualSendRequestId      String?
  createdByUserId          String?
  recipientPhoneE164       String
  purpose                  WhatsAppMessagePurpose
  trigger                  WhatsAppMessageTrigger
  automationStage          WhatsAppAutomationStage?
  managedTemplateKey       WhatsAppManagedTemplateKey?
  catalogVersion           Int?
  catalogHash              String?
  templateVersion          Int?
  templateVariables        Json
  renderedPreview          String?
  scheduledFor             DateTime
  localScheduleDate        DateTime?
  status                   WhatsAppMessageStatus       @default(SCHEDULED)
  dedupeKey                String                      @unique
  frequencyKey             String?                     @unique
  settingsRevision         Int?
  sourceFingerprint        String
  providerMessageId        String?                     @unique
  providerRecipientWaId    String?
  providerPricingCategory  String?
  providerBillable         Boolean?
  providerStatusTimestamp  DateTime?
  attemptCount             Int                         @default(0)
  leaseToken               String?                     @unique
  leaseUntil               DateTime?
  budgetMonth              String?
  budgetState              WhatsAppBudgetState         @default(NONE)
  rateCardVersion          String?
  estimatedCostMicros      BigInt?
  actualCostMicros         BigInt?
  currency                 String                      @default("INR")
  failureCode              String?
  safeFailureMessage       String?
  availableAt              DateTime
  claimedAt                DateTime?
  submissionStartedAt      DateTime?
  acceptedAt               DateTime?
  sentAt                   DateTime?
  deliveredAt              DateTime?
  readAt                   DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  suppressedAt             DateTime?
  lastAttemptAt            DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                   Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sender                   WhatsAppSender              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  student                  Student?                    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  payment                  Payment?                    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentResolutionEvent   PaymentResolutionEvent?     @relation(fields: [paymentResolutionEventId], references: [id], onDelete: Restrict)
  template                 WhatsAppTemplate?           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateBinding          WhatsAppTemplateBinding?    @relation(fields: [templateBindingId], references: [id], onDelete: Restrict)
  manualSendRequest        WhatsAppManualSendRequest?  @relation(fields: [manualSendRequestId], references: [id], onDelete: Restrict)
  createdBy                User?                       @relation("WhatsAppMessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events                   WhatsAppMessageEvent[]
  paymentSources           WhatsAppMessagePayment[]

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([status, availableAt, scheduledFor])
  @@index([senderId, status, scheduledFor])
  @@index([branchId, budgetMonth, budgetState])
  @@index([branchId, trigger, automationStage, scheduledFor])
  @@index([senderId, recipientPhoneE164, localScheduleDate])
  @@index([manualSendRequestId, createdAt])
  @@index([studentId, createdAt])
  @@index([paymentId, createdAt])
  @@index([paymentResolutionEventId, createdAt])
}

model WhatsAppMessagePayment {
