generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                        @id @default(cuid())
  clerkId                       String?                       @unique
  email                         String                        @unique
  name                          String?
  phone                         String?
  timezone                      String                        @default("Asia/Kolkata")
  locale                        String                        @default("en-IN")
  dateFormat                    String                        @default("dd MMM yyyy")
  themePreference               String                        @default("dark")
  densityPreference             String                        @default("comfortable")
  defaultMessageLanguage        String                        @default("en")
  defaultLandingPage            String                        @default("org")
  createdAt                     DateTime                      @default(now())
  organizations                 Organization[]
  staff                         Staff[]
  auditLogs                     AuditLog[]
  importSessionsUploaded        ImportSession[]               @relation("ImportSessionUploadedBy")
  importCommits                 ImportCommit[]                @relation("ImportCommitCommittedBy")
  importPlansCompiled           ImportPlan[]                  @relation("ImportPlanCompiledBy")
  importRunsRequested           ImportRun[]                   @relation("ImportRunRequestedBy")
  importRunsCancelled           ImportRun[]                   @relation("ImportRunCancelledBy")
  importRecipesCreated          ImportRecipe[]                @relation("ImportRecipeCreatedBy")
  paymentResolutionEvents       PaymentResolutionEvent[]      @relation("PaymentResolutionEventActor")
  whatsAppSendersConnected      WhatsAppSender[]              @relation("WhatsAppSenderConnectedBy")
  whatsAppConnectionIntents     WhatsAppConnectionIntent[]    @relation("WhatsAppConnectionIntentActor")
  whatsAppConsentsRecorded      WhatsAppConsent[]             @relation("WhatsAppConsentRecordedBy")
  whatsAppConsentEvents         WhatsAppConsentEvent[]        @relation("WhatsAppConsentEventActor")
  whatsAppRecipientsCreated     WhatsAppStudentRecipient[]    @relation("WhatsAppStudentRecipientCreatedBy")
  whatsAppAutomationsEnabled    BranchWhatsAppSettings[]      @relation("BranchWhatsAppAutomationEnabledBy")
  whatsAppManualSendRequests    WhatsAppManualSendRequest[]   @relation("WhatsAppManualSendRequestActor")
  whatsAppMessagesCreated       WhatsAppMessage[]             @relation("WhatsAppMessageCreatedBy")
  whatsAppAuditEvents           WhatsAppAuditEvent[]          @relation("WhatsAppAuditEventActor")
  whatsAppReportSubscriptions   WhatsAppReportSubscription[]  @relation("WhatsAppReportSubscriptionUser")
  whatsAppServiceNoticesCreated WhatsAppServiceNotice[]       @relation("WhatsAppServiceNoticeActor")
  whatsAppSenderSafetyPauses    WhatsAppSenderSafetyState[]   @relation("WhatsAppSenderSafetyPausedBy")
  whatsAppIncidentsAcknowledged WhatsAppOperationalIncident[] @relation("WhatsAppOperationalIncidentAcknowledgedBy")
  ownerTrialGrant               OwnerTrialGrant?
}

model Organization {
  id                             String                              @id @default(cuid())
  name                           String
  ownerId                        String
  businessType                   String?
  legalName                      String?
  contactEmail                   String?
  contactPhone                   String?
  address                        String?
  timezone                       String                              @default("Asia/Kolkata")
  currency                       String                              @default("INR")
  weekStartsOn                   Int                                 @default(1)
  paymentGraceDays               Int                                 @default(0)
  selectedPostTrialPlan          SaasPlan?
  billingModelVersion            BillingModelVersion                 @default(LEGACY)
  billingMutationSequence        Int                                 @default(0)
  billingMutationLeaseToken      String?
  billingMutationLeaseUntil      DateTime?
  createdAt                      DateTime                            @default(now())
  branches                       Branch[]
  subscription                   OrganizationSubscription?           @relation("OrganizationCurrentSubscription")
  pendingSubscriptionReplacement OrganizationSubscription?           @relation("OrganizationPendingSubscriptionReplacement")
  subscriptions                  OrganizationSubscription[]          @relation("OrganizationSubscriptionOwner")
  subscriptionHistory            OrganizationSubscriptionHistory[]
  razorpayWebhookEvents          RazorpayWebhookEvent[]
  ownerTrialGrant                OwnerTrialGrant?
  billingChanges                 OrganizationBillingChange[]
  billingChangeAudits            OrganizationBillingChangeAudit[]
  offerGrants                    OrganizationOfferGrant[]
  subscriptionInvoices           OrganizationSubscriptionInvoice[]
  importRecipes                  ImportRecipe[]
  whatsAppSenders                WhatsAppSender[]
  whatsAppConnectionIntents      WhatsAppConnectionIntent[]
  branchWhatsAppSettings         BranchWhatsAppSettings[]
  whatsAppStudentRecipients      WhatsAppStudentRecipient[]
  whatsAppAutomationRules        WhatsAppAutomationRule[]
  whatsAppManualSendRequests     WhatsAppManualSendRequest[]
  whatsAppMessages               WhatsAppMessage[]
  whatsAppWebhookReceipts        WhatsAppWebhookReceipt[]
  whatsAppAuditEvents            WhatsAppAuditEvent[]
  whatsAppReportSettings         OrganizationWhatsAppReportSettings?
  whatsAppReportSubscriptions    WhatsAppReportSubscription[]
  whatsAppDailyReportSnapshots   WhatsAppDailyReportSnapshot[]
  whatsAppServiceNotices         WhatsAppServiceNotice[]
  whatsAppOperationalIncidents   WhatsAppOperationalIncident[]
  owner                          User                                @relation(fields: [ownerId], references: [id])
}

model Branch {
  id                           String                        @id @default(cuid())
  organizationId               String
  name                         String
  city                         String?
  address                      String?
  contactPhone                 String?
  openingTime                  String?
  closingTime                  String?
  defaultFee                   Int?                          @default(0)
  defaultAdmissionFee          Int?                          @default(0)
  defaultMessageLanguage       String                        @default("en")
  reminderTone                 String                        @default("polite")
  aiEnabled                    Boolean                       @default(true)
  createdAt                    DateTime                      @default(now())
  lastDataChange               DateTime                      @default(now())
  aiLastCalledAt               DateTime?
  aiStatus                     BranchAIStatus                @default(IDLE)
  billingStatus                BranchBillingStatus           @default(ACTIVE)
  billingActivatedAt           DateTime?
  billingArchivedAt            DateTime?
  organization                 Organization                  @relation(fields: [organizationId], references: [id])
  aiReports                    BranchAIReport[]
  messageDrafts                MessageDraft[]
  generationLeases             BranchGenerationLease[]
  multiShifts                  MultiShift[]
  payments                     Payment[]
  paymentResolutionEvents      PaymentResolutionEvent[]
  seats                        Seat[]
  shifts                       Shift[]
  staff                        Staff[]
  staffInvites                 StaffInvite[]
  students                     Student[]
  auditLogs                    AuditLog[]
  importSessions               ImportSession[]
  importRecipes                ImportRecipe[]
  importRuns                   ImportRun[]
  billingChanges               OrganizationBillingChange[]
  whatsAppSettings             BranchWhatsAppSettings?
  whatsAppStudentRecipients    WhatsAppStudentRecipient[]
  whatsAppAutomationRules      WhatsAppAutomationRule[]
  whatsAppManualSendRequests   WhatsAppManualSendRequest[]
  whatsAppMessages             WhatsAppMessage[]
  whatsAppAuditEvents          WhatsAppAuditEvent[]
  whatsAppReportSubscriptions  WhatsAppReportSubscription[]
  whatsAppDailyReportSnapshots WhatsAppDailyReportSnapshot[]
  whatsAppServiceNotices       WhatsAppServiceNotice[]
  whatsAppOperationalIncidents WhatsAppOperationalIncident[]

  @@unique([id, organizationId], map: "TI_U_Branch_id_organizationId")
}

model Student {
  id                    String                     @id @default(cuid())
  branchId              String
  name                  String
  phone                 String?
  status                StudentStatus              @default(ACTIVE)
  enrollmentSource      StudentEnrollmentSource    @default(LEGACY)
  joinedAt              DateTime                   @default(now())
  billingStartAt        DateTime?
  monthlyFee            Int                        @default(0)
  feeLinkedShiftId      String?
  feeLinkedMultiShiftId String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  messageDrafts         MessageDraft[]
  payments              Payment[]
  seatAllocations       SeatAllocation[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppRecipients    WhatsAppStudentRecipient[]
  branch                Branch                     @relation(fields: [branchId], references: [id])
  feeLinkedShift        Shift?                     @relation("StudentFeeShift", fields: [feeLinkedShiftId, branchId], references: [id, branchId], onDelete: Restrict)
  feeLinkedMultiShift   MultiShift?                @relation("StudentFeeMultiShift", fields: [feeLinkedMultiShiftId, branchId], references: [id, branchId], onDelete: Restrict)

  @@index([branchId])
  @@unique([id, branchId])
  @@index([branchId, billingStartAt])
  @@index([feeLinkedShiftId])
  @@index([feeLinkedMultiShiftId])
}

model Seat {
  id              String           @id @default(cuid())
  branchId        String
  label           String
  createdAt       DateTime         @default(now())
  branch          Branch           @relation(fields: [branchId], references: [id])
  seatAllocations SeatAllocation[]

  @@unique([id, branchId])
  @@unique([branchId, label])
  @@index([branchId])
}

model Shift {
  id                   String                @id @default(cuid())
  branchId             String
  name                 String
  startTime            String?
  endTime              String?
  price                Int                   @default(0)
  isReserved           Boolean               @default(false)
  status               ShiftStatus           @default(ACTIVE)
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  seatAllocations      SeatAllocation[]
  multiShiftComponents MultiShiftComponent[]
  feeLinkedStudents    Student[] @relation("StudentFeeShift")
  branch               Branch                @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@unique([id, branchId])
  @@index([branchId, status])
}

model MultiShift {
  id          String                @id @default(cuid())
  branchId    String
  name        String
  price       Int                   @default(0)
  createdAt   DateTime              @default(now())
  branch      Branch                @relation(fields: [branchId], references: [id])
  components  MultiShiftComponent[]
  allocations SeatAllocation[]
  feeLinkedStudents Student[] @relation("StudentFeeMultiShift")

  @@unique([id, branchId])
  @@unique([branchId, name])
  @@index([branchId])
}

model MultiShiftComponent {
  id           String     @id @default(cuid())
  branchId     String
  multiShiftId String
  shiftId      String
  order        Int        @default(0)
  multiShift   MultiShift @relation(fields: [multiShiftId, branchId], references: [id, branchId], onDelete: Cascade)
  shift        Shift      @relation(fields: [shiftId, branchId], references: [id, branchId])

  @@unique([multiShiftId, shiftId])
  @@index([branchId, shiftId])
}

model SeatAllocation {
  id           String      @id @default(cuid())
  branchId     String
  seatId       String
  studentId    String
  shiftId      String
  multiShiftId String?
  startDate    DateTime    @default(now())
  endDate      DateTime?
  seat         Seat        @relation(fields: [seatId, branchId], references: [id, branchId])
  shift        Shift       @relation(fields: [shiftId, branchId], references: [id, branchId])
  student      Student     @relation(fields: [studentId, branchId], references: [id, branchId])
  multiShift   MultiShift? @relation(fields: [multiShiftId, branchId], references: [id, branchId], onDelete: Restrict)

  @@index([branchId, shiftId, endDate])
  @@index([seatId, shiftId])
  @@index([studentId])
  @@index([multiShiftId])
}

model Payment {
  id                     String                   @id @default(cuid())
  branchId               String
  studentId              String
  periodStart            DateTime
  periodEnd              DateTime
  dueDate                DateTime
  amount                 Int
  status                 PaymentStatus            @default(DUE)
  paidAt                 DateTime?
  paymentMethod          PaymentMethod?
  referenceId            String?
  type                   PaymentType              @default(MONTHLY)
  createdAt              DateTime                 @default(now())
  branch                 Branch                   @relation(fields: [branchId], references: [id])
  student                Student                  @relation(fields: [studentId, branchId], references: [id, branchId])
  auditLogs              AuditLog[]
  resolutionEvents       PaymentResolutionEvent[]
  whatsAppMessages       WhatsAppMessage[]
  whatsAppMessageSources WhatsAppMessagePayment[]

  @@unique([studentId, type, periodStart], map: "Payment_studentId_type_periodStart_key")
  @@unique([id, branchId])
  @@index([branchId, dueDate])
}

model PaymentResolutionEvent {
  id               String                       @id @default(cuid())
  paymentId        String
  branchId         String
  actorUserId      String?
  source           PaymentResolutionEventSource
  fromStatus       PaymentStatus
  toStatus         PaymentStatus
  amount           Int
  paymentType      PaymentType
  periodStart      DateTime
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  referenceId      String?
  details          Json?
  occurredAt       DateTime                     @default(now())
  payment          Payment                      @relation(fields: [paymentId, branchId], references: [id, branchId], onDelete: Restrict)
  branch           Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor            User?                        @relation("PaymentResolutionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  whatsAppMessages WhatsAppMessage[]

  @@index([paymentId, occurredAt, id])
  @@index([branchId, occurredAt, id])

  @@unique([id, branchId], map: "TI_U_PaymentResolutionEvent_id_branchId")
}

model Staff {
  id                  String                    @id @default(cuid())
  userId              String
  branchId            String
  role                StaffRole
  createdAt           DateTime                  @default(now())
  branch              Branch                    @relation(fields: [branchId], references: [id])
  user                User                      @relation(fields: [userId], references: [id])
  permissionOverrides StaffPermissionOverride[]

  @@unique([userId, branchId])
  @@index([branchId])
}

model StaffPermissionOverride {
  id        String                @id @default(cuid())
  staffId   String
  action    StaffPermissionAction
  allowed   Boolean
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  staff     Staff                 @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, action])
  @@index([staffId])
}

model StaffInvite {
  id         String    @id @default(cuid())
  branchId   String
  role       StaffRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  branch     Branch    @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([expiresAt])
}

model BranchAIReport {
  id        String   @id @default(cuid())
  branchId  String
  data      Json
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
}

model MessageDraft {
  id        String   @id @default(cuid())
  branchId  String
  studentId String?
  action    String
  language  String   @default("en")
  message   String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  /// SQL migration uses SET NULL (studentId), preserving the required branch.
  student   Student? @relation(fields: [studentId, branchId], references: [id, branchId], onDelete: SetNull)

  @@index([branchId, studentId])
  @@unique([branchId, studentId, action, language])
}

model BranchGenerationLease {
  id            String @id @default(cuid())
  branchId      String
  kind          String
  token         String?
  leaseUntil    DateTime?
  lastStartedAt DateTime
  branch        Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, kind])
}

model WhatsAppInboundMessageReceipt {
  id                String @id @default(cuid())
  senderId          String
  providerMessageId String
  createdAt         DateTime @default(now())
  sender            WhatsAppSender @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@unique([senderId, providerMessageId])
}

model WhatsAppSender {
  inboundMessageReceipts       WhatsAppInboundMessageReceipt[]
  id                           String                                @id @default(cuid())
  organizationId               String
  provider                     WhatsAppProvider
  providerMode                 WhatsAppProviderMode
  providerBusinessId           String?
  wabaId                       String
  phoneNumberId                String
  displayPhoneNumber           String
  verifiedName                 String?
  qualityRating                String?
  accountMode                  String?
  status                       WhatsAppSenderStatus                  @default(PENDING)
  phoneRegisteredAt            DateTime?
  webhookSubscribedAt          DateTime?
  connectedByUserId            String?
  connectedAt                  DateTime?
  disconnectedAt               DateTime?
  lastSyncedAt                 DateTime?
  lastTemplateSyncAt           DateTime?
  lastHealthCheckAt            DateTime?
  lastWebhookReceivedAt        DateTime?
  healthLeaseToken             String?                               @unique
  healthLeaseUntil             DateTime?
  providerRegistrationStatus   String?
  providerRestrictionCode      String?
  lastErrorCode                String?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  organization                 Organization                          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectedBy                  User?                                 @relation("WhatsAppSenderConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  branchSettings               BranchWhatsAppSettings[]
  templates                    WhatsAppTemplate[]
  managedTemplateProvisionings WhatsAppManagedTemplateProvisioning[]
  templateBindings             WhatsAppTemplateBinding[]
  consents                     WhatsAppConsent[]
  consentEvents                WhatsAppConsentEvent[]
  studentRecipients            WhatsAppStudentRecipient[]
  messages                     WhatsAppMessage[]
  messageEvents                WhatsAppMessageEvent[]
  webhookReceipts              WhatsAppWebhookReceipt[]
  auditEvents                  WhatsAppAuditEvent[]
  reportSettings               OrganizationWhatsAppReportSettings[]
  reportSubscriptions          WhatsAppReportSubscription[]
  serviceNotices               WhatsAppServiceNotice[]
  safetyState                  WhatsAppSenderSafetyState?
  operationalIncidents         WhatsAppOperationalIncident[]

  @@unique([provider, providerMode, phoneNumberId])
  @@index([organizationId, status])
  @@index([provider, providerMode, wabaId])
  @@index([status, healthLeaseUntil, lastHealthCheckAt])

  @@unique([id, organizationId], map: "TI_U_WhatsAppSender_id_organizationId")
}

model WhatsAppConnectionIntent {
  id                 String                         @id @default(cuid())
  organizationId     String
  actorUserId        String
  providerMode       WhatsAppProviderMode
  stateHash          String                         @unique
  status             WhatsAppConnectionIntentStatus @default(CREATED)
  leaseToken         String?                        @unique
  leaseUntil         DateTime?
  attemptCount       Int                            @default(0)
  providerBusinessId String?
  wabaId             String?
  phoneNumberId      String?
  expiresAt          DateTime
  consumedAt         DateTime?
  lastErrorCode      String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor              User                           @relation("WhatsAppConnectionIntentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([actorUserId, status, expiresAt])
}

model BranchWhatsAppSettings {
  branchId                               String          @id
  organizationId                         String
  senderId                               String?
  enabled                                Boolean         @default(false)
  defaultLanguage                        String          @default("en")
  defaultTone                            String          @default("polite")
  monthlyBudgetMinor                     Int?
  sendTimeLocal                          String          @default("10:00")
  dailyAutomaticMessageLimit             Int             @default(50)
  maxAutomaticCollectionMessagesPerCycle Int             @default(4)
  automationEnabledAt                    DateTime?
  automationEnabledByUserId              String?
  configurationRevision                  Int             @default(1)
  plannerLeaseToken                      String?         @unique
  plannerLeaseUntil                      DateTime?
  lastPlannedAt                          DateTime?
  plannerRecipientCursorPhoneE164        String?
  plannerCorrectionCursorAt              DateTime?
  plannerCorrectionCursorId              String?
  plannerPaidCursorAt                    DateTime?
  plannerPaidCursorId                    String?
  lastPlannerErrorCode                   String?
  createdAt                              DateTime        @default(now())
  updatedAt                              DateTime        @updatedAt
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "TI_BranchWhatsAppSettings_branch_organizationId")
  organization                           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sender WhatsAppSender? @relation(fields: [senderId, organizationId], references: [id, organizationId], onDelete: SetNull, map: "TI_BranchWhatsAppSettings_sender_organizationId")
  automationEnabledBy                    User?           @relation("BranchWhatsAppAutomationEnabledBy", fields: [automationEnabledByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@unique([branchId, organizationId], map: "TI_U_BranchWhatsAppSettings_branchId_organizationId")
  @@index([senderId])
  @@index([enabled, automationEnabledAt, plannerLeaseUntil])
}

model WhatsAppTemplate {
  id                 String                         @id @default(cuid())
  senderId           String
  providerTemplateId String
  name               String
  language           String
  category           WhatsAppTemplateCategory
  providerStatus     WhatsAppTemplateProviderStatus
  version            Int                            @default(1)
  components         Json
  componentHash      String
  lastSyncedAt       DateTime
  staleAt            DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  sender             WhatsAppSender                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  messages           WhatsAppMessage[]
  binding            WhatsAppTemplateBinding?

  @@unique([senderId, providerTemplateId])
  @@unique([senderId, name, language])
  @@index([senderId, category, providerStatus])

  @@unique([id, senderId], map: "TI_U_WhatsAppTemplate_id_senderId")
}

model WhatsAppConsent {
  id                  String                       @id @default(cuid())
  senderId            String
  phoneE164           String
  consentType         WhatsAppConsentType
  status              WhatsAppConsentStatus        @default(UNKNOWN)
  source              WhatsAppConsentSource
  policyVersion       String?
  grantedAt           DateTime?
  revokedAt           DateTime?
  recordedByUserId    String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  sender              WhatsAppSender               @relation(fields: [senderId], references: [id], onDelete: Restrict)
  recordedBy          User?                        @relation("WhatsAppConsentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  events              WhatsAppConsentEvent[]
  studentRecipients   WhatsAppStudentRecipient[]
  reportSubscriptions WhatsAppReportSubscription[]

  @@unique([senderId, phoneE164, consentType])

  @@unique([id, senderId], map: "TI_U_WhatsAppConsent_id_senderId")
}

model WhatsAppConsentEvent {
  id             String                @id @default(cuid())
  consentId      String
  senderId       String
  phoneE164      String
  consentType    WhatsAppConsentType
  actorUserId    String?
  previousStatus WhatsAppConsentStatus
  nextStatus     WhatsAppConsentStatus
  source         WhatsAppConsentSource
  policyVersion  String?
  details        Json?
  occurredAt     DateTime              @default(now())
  consent WhatsAppConsent @relation(fields: [consentId, senderId], references: [id, senderId], onDelete: Restrict, map: "TI_WhatsAppConsentEvent_consent_senderId")
  sender         WhatsAppSender        @relation(fields: [senderId], references: [id], onDelete: Restrict)
  actor          User?                 @relation("WhatsAppConsentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([consentId, occurredAt, id])
  @@index([senderId, occurredAt, id])
}

model WhatsAppStudentRecipient {
  id              String                         @id @default(cuid())
  organizationId  String
  branchId        String
  studentId       String
  senderId        String
  consentId       String
  phoneE164       String
  relationship    WhatsAppRecipientRelationship
  status          WhatsAppStudentRecipientStatus @default(ACTIVE)
  verifiedAt      DateTime
  staleAt         DateTime?
  disabledAt      DateTime?
  createdByUserId String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "TI_WhatsAppStudentRecipient_branch_organizationId")
  student Student @relation(fields: [studentId, branchId], references: [id, branchId], onDelete: Restrict, map: "TI_WhatsAppStudentRecipient_student_branchId")
  sender WhatsAppSender @relation(fields: [senderId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "TI_WhatsAppStudentRecipient_sender_organizationId")
  consent WhatsAppConsent @relation(fields: [consentId, senderId], references: [id, senderId], onDelete: Restrict, map: "TI_WhatsAppStudentRecipient_consent_senderId")
  createdBy       User?                          @relation("WhatsAppStudentRecipientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([studentId, senderId])
  @@index([branchId, status])
  @@index([senderId, phoneE164, status])
  @@index([consentId])
}

model WhatsAppManagedTemplateProvisioning {
  id                   String                                    @id @default(cuid())
  senderId             String
  managedKey           WhatsAppManagedTemplateKey
  language             String
  catalogVersion       Int
  catalogHash          String
  providerTemplateName String
  providerTemplateId   String?
  status               WhatsAppManagedTemplateProvisioningStatus @default(PENDING)
  attemptCount         Int                                       @default(0)
  leaseToken           String?                                   @unique
  leaseUntil           DateTime?
  lastAttemptAt        DateTime?
  lastErrorCode        String?
  createdAt            DateTime                                  @default(now())
  updatedAt            DateTime                                  @updatedAt
  sender               WhatsAppSender                            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  binding              WhatsAppTemplateBinding?

  @@unique([senderId, managedKey, language, catalogVersion])
  @@unique([senderId, providerTemplateName])
  @@index([senderId, status])

  @@unique([id, senderId], map: "TI_U_WhatsAppManagedTemplateProvisioning_id_senderId")
}

model WhatsAppTemplateBinding {
  id             String                              @id @default(cuid())
  senderId       String
  templateId     String                              @unique
  provisioningId String                              @unique
  managedKey     WhatsAppManagedTemplateKey
  language       String
  catalogVersion Int
  catalogHash    String
  active         Boolean                             @default(false)
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  sender         WhatsAppSender                      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  template WhatsAppTemplate @relation(fields: [templateId, senderId], references: [id, senderId], onDelete: Restrict, map: "TI_WhatsAppTemplateBinding_template_senderId")
