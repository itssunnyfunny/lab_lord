  message   WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@id([messageId, paymentId])
  @@index([paymentId])
}

model WhatsAppMessageEvent {
  id                      String                     @id @default(cuid())
  messageId               String?
  senderId                String
  providerMessageId       String?
  eventKey                String                     @unique
  source                  WhatsAppMessageEventSource
  status                  WhatsAppMessageStatus
  providerTimestamp       DateTime?
  receivedAt              DateTime                   @default(now())
  payloadHash             String
  providerRecipientWaId   String?
  providerBillable        Boolean?
  providerPricingCategory String?
  safeErrorCode           String?
  expiresAt               DateTime?
  message                 WhatsAppMessage?           @relation(fields: [messageId], references: [id], onDelete: Restrict)
  sender                  WhatsAppSender             @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([providerMessageId, providerTimestamp, id])
  @@index([messageId, providerTimestamp, id])
  @@index([senderId, expiresAt])
}

model WhatsAppWebhookReceipt {
  id               String                       @id @default(cuid())
  providerMode     WhatsAppProviderMode
  dedupeKey        String                       @unique
  payloadHash      String
  signatureVersion String
  organizationId   String?
  senderId         String?
  wabaId           String?
  phoneNumberId    String?
  eventType        String?
  status           WhatsAppWebhookReceiptStatus @default(RECEIVED)
  attemptCount     Int                          @default(0)
