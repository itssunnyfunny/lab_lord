  razorpayPlanId                    String
  razorpaySubscriptionId            String                            @unique
  razorpayCustomerId                String?
  status                            SaasSubscriptionStatus            @default(CREATED)
  authPaymentId                     String?                           @unique
  providerStartAt                   DateTime?
  authorizationExpiresAt            DateTime?
  providerPaymentMethod             ProviderPaymentMethod             @default(UNKNOWN)
  paidThrough                       DateTime?
  lastConfirmedInvoiceId            String?
  lastConfirmedPaymentId            String?
  lastPaymentConfirmedAt            DateTime?
  authorizationLapsedAt             DateTime?
  billingOfferId                    String?
  confirmedCommercialIntentChangeId String?                           @unique
  lastReconciledAt                  DateTime?
  currentStart                      DateTime?
  currentEnd                        DateTime?
  chargeAt                          DateTime?
  endedAt                           DateTime?
  cancelAtCycleEnd                  Boolean                           @default(false)
  cancellationRequestedAt           DateTime?
  cancellationScheduledAt           DateTime?
  cancelledAt                       DateTime?
  createdByUserId                   String?
  createdAt                         DateTime                          @default(now())
  updatedAt                         DateTime                          @updatedAt
  organization                      Organization                      @relation("OrganizationSubscriptionOwner", fields: [organizationId], references: [id])
  currentForOrganization            Organization?                     @relation("OrganizationCurrentSubscription", fields: [currentOrganizationId], references: [id], onDelete: SetNull)
  pendingReplacementForOrganization Organization?                     @relation("OrganizationPendingSubscriptionReplacement", fields: [pendingReplacementOrganizationId], references: [id], onDelete: SetNull)
  replacesSubscription              OrganizationSubscription?         @relation("OrganizationSubscriptionReplacementLineage", fields: [replacesSubscriptionId], references: [id], onDelete: SetNull)
  replacementSubscriptions          OrganizationSubscription[]        @relation("OrganizationSubscriptionReplacementLineage")
  billingOffer                      BillingOffer?                     @relation(fields: [billingOfferId], references: [id])
  confirmedCommercialIntentChange   OrganizationBillingChange?        @relation("ConfirmedCommercialIntent", fields: [confirmedCommercialIntentChangeId], references: [id], onDelete: SetNull)
  webhookEvents                     RazorpayWebhookEvent[]
  history                           OrganizationSubscriptionHistory[]
  billingChanges                    OrganizationBillingChange[]       @relation("BillingChangeSourceSubscription")
  replacementBillingChange          OrganizationBillingChange?        @relation("BillingChangeReplacementSubscription")
  invoices                          OrganizationSubscriptionInvoice[]

  @@index([providerMode, status])
  @@index([providerMode, plan])
  @@index([providerMode, razorpaySubscriptionId])
  @@index([organizationId, createdAt])
  @@index([replacesSubscriptionId])
}

model OrganizationBillingChange {
  id                                     String                            @id @default(cuid())
  organizationId                         String
  organizationSubscriptionId             String?
  replacementSubscriptionId              String?                           @unique
  branchId                               String?
  sequence                               Int
  idempotencyKey                         String                            @unique
  type                                   BillingChangeType
  status                                 BillingChangeStatus               @default(QUEUED)
  operationStatus                        BillingOperationStatus            @default(AWAITING_PROVIDER_CONFIRMATION)
  fromPlan                               SaasPlan?
  toPlan                                 SaasPlan?
  fromQuantity                           Int?
  toQuantity                             Int?
  commercialIntentVersion                Int?
  commercialIntentCapturedAt             DateTime?
  authorizedProviderMode                 RazorpayMode?
  authorizedSourceRazorpaySubscriptionId String?
  authorizedRazorpaySubscriptionId       String?
  authorizedSourceRazorpayPlanId         String?
  authorizedRazorpayPlanId               String?
  authorizedPlan                         SaasPlan?
  authorizedQuantity                     Int?
  authorizedRazorpayOfferId              String?
  authorizedUnitAmountSubunits           Int?
  authorizedGrossAmountSubunits          Int?
  authorizedExpectedAmountSubunits       Int?
  authorizedOfferValidThroughPaidCount   Int?
  authorizedCurrency                     String?
  authorizedPeriod                       String?
  authorizedInterval                     Int?
  effectiveAt                            DateTime?
  undoCutoffAt                           DateTime?
  providerInvoiceId                      String?
  providerPaymentId                      String?
  attemptCount                           Int                               @default(0)
  processingStartedAt                    DateTime?
  appliedAt                              DateTime?
  undoneAt                               DateTime?
  failedAt                               DateTime?
  lastError                              String?
  returnPath                             String?
  confirmationDeadlineAt                 DateTime?
  failureCategory                        String?
  failureCode                            String?
  checkoutOpenedAt                       DateTime?
  verificationStartedAt                  DateTime?
  providerConfirmedAt                    DateTime?
  accessGrantedAt                        DateTime?
  accessRevokedAt                        DateTime?
  accessGraceEndsAt                      DateTime?
  abandonedAt                            DateTime?
  declinedAt                             DateTime?
  resolvedAt                             DateTime?
  createdByUserId                        String?
  createdAt                              DateTime                          @default(now())
  updatedAt                              DateTime                          @updatedAt
  organization                           Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSubscription               OrganizationSubscription?         @relation("BillingChangeSourceSubscription", fields: [organizationSubscriptionId], references: [id], onDelete: SetNull)
  replacementSubscription                OrganizationSubscription?         @relation("BillingChangeReplacementSubscription", fields: [replacementSubscriptionId], references: [id], onDelete: SetNull)
  confirmedCommercialSubscription        OrganizationSubscription?         @relation("ConfirmedCommercialIntent")
  commercialEvidenceInvoices             OrganizationSubscriptionInvoice[] @relation("InvoiceCommercialIntent")
  branch                                 Branch?                           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sequence])
  @@index([organizationId, status, sequence])
  @@index([organizationId, operationStatus, sequence])
  @@index([organizationId, commercialIntentVersion, sequence], map: "BillingChange_commercial_intent_idx")
  @@index([authorizedProviderMode, authorizedRazorpaySubscriptionId, sequence], map: "BillingChange_authorized_subscription_idx")
  @@index([authorizedProviderMode, authorizedSourceRazorpaySubscriptionId, sequence], map: "BillingChange_authorized_source_subscription_idx")
  @@index([undoCutoffAt, status])
}

model OrganizationSubscriptionInvoice {
  id                         String                     @id @default(cuid())
  organizationId             String
  organizationSubscriptionId String?
  razorpayInvoiceId          String                     @unique
  razorpayPaymentId          String?                    @unique
  status                     String
  amountSubunits             Int
  amountPaidSubunits         Int                        @default(0)
  amountDueSubunits          Int                        @default(0)
  currency                   String                     @default("INR")
  paymentMethod              ProviderPaymentMethod      @default(UNKNOWN)
  commercialEvidenceVersion  Int?
  commercialIntentChangeId   String?
  providerMode               RazorpayMode?
  razorpaySubscriptionId     String?
  razorpayPlanId             String?
  providerQuantity           Int?
  razorpayOfferId            String?
  paymentAmountSubunits      Int?
  paymentCurrency            String?
  paymentStatus              String?
  paymentCaptured            Boolean?
  evidenceConfirmedAt        DateTime?
  evidenceFailureCode        String?
  periodStart                DateTime?
  periodEnd                  DateTime?
  issuedAt                   DateTime?
  paidAt                     DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSubscription   OrganizationSubscription?  @relation(fields: [organizationSubscriptionId], references: [id], onDelete: SetNull)
  commercialIntentChange     OrganizationBillingChange? @relation("InvoiceCommercialIntent", fields: [commercialIntentChangeId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationSubscriptionId, createdAt])
  @@index([providerMode, razorpaySubscriptionId, periodEnd], map: "SubscriptionInvoice_provider_period_idx")
  @@index([commercialIntentChangeId, paidAt], map: "SubscriptionInvoice_commercial_intent_idx")
}

model OrganizationSubscriptionHistory {
  id                         String                        @id @default(cuid())
  organizationId             String
  organizationSubscriptionId String?
  razorpaySubscriptionId     String
  razorpayPaymentId          String?
  plan                       SaasPlan
  fromStatus                 SaasSubscriptionStatus?
  toStatus                   SaasSubscriptionStatus
  source                     SaasSubscriptionHistorySource
  event                      String?
  amountSubunits             Int
  quantity                   Int                           @default(1)
  unitAmountSubunits         Int                           @default(0)
  totalAmountSubunits        Int                           @default(0)
  paidThrough                DateTime?
  dedupeKey                  String?                       @unique
  currency                   String
  createdAt                  DateTime                      @default(now())
  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSubscription   OrganizationSubscription?     @relation(fields: [organizationSubscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationSubscriptionId, createdAt])
  @@index([razorpaySubscriptionId])
}

model RazorpayWebhookEvent {
  id                         String                    @id @default(cuid())
  eventId                    String                    @unique
  event                      String
  organizationId             String?
  organizationSubscriptionId String?
  razorpayPaymentId          String?
  razorpaySubscriptionId     String?
  payloadHash                String
  receivedAt                 DateTime                  @default(now())
  processedAt                DateTime?
  processingError            String?
  organization               Organization?             @relation(fields: [organizationId], references: [id])
  organizationSubscription   OrganizationSubscription? @relation(fields: [organizationSubscriptionId], references: [id])

  @@index([organizationId])
  @@index([organizationSubscriptionId])
  @@index([razorpayPaymentId])
  @@index([razorpaySubscriptionId])
}

enum AuditAction {
  PAYMENT_MARKED_PAID
  PAYMENT_WAIVED
}
