  readinessPolicy  ImportReadinessPolicy
  planVersion      String                @unique
  canRun           Boolean
  totalRows        Int
  readyRows        Int
  blockedRows      Int
  warningRows      Int
  skippedRows      Int
  snapshot         Json
  checks           Json
  summary          Json
  compiledByUserId String
  createdAt        DateTime              @default(now())

  session    ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  compiledBy User          @relation("ImportPlanCompiledBy", fields: [compiledByUserId], references: [id])
  runs       ImportRun[]

  @@unique([importSessionId, revision, readinessPolicy])
  @@index([importSessionId, createdAt])
}

model ImportRun {
  id                      String          @id @default(cuid())
  branchId                String
  importSessionId         String?
  importPlanId            String?
  targetRevision          Int
  requestedByUserId       String
  idempotencyKey          String          @unique
  requestHash             String
  workflowRunId           String?         @unique
  kind                    ImportRunKind
  status                  ImportRunStatus @default(QUEUED)
  maxAttempts             Int             @default(3)
  totalItems              Int
  completedItems          Int             @default(0)
  succeededItems          Int             @default(0)
  failedItems             Int             @default(0)
  skippedItems            Int             @default(0)
  cancelledItems          Int             @default(0)
  cancelRequestedAt       DateTime?
  cancelRequestedByUserId String?
  startedAt               DateTime?
  finishedAt              DateTime?
  lastHeartbeatAt         DateTime?
  error                   Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  session           ImportSession?  @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  plan              ImportPlan?     @relation(fields: [importPlanId], references: [id], onDelete: SetNull)
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy       User            @relation("ImportRunRequestedBy", fields: [requestedByUserId], references: [id])
  cancelRequestedBy User?           @relation("ImportRunCancelledBy", fields: [cancelRequestedByUserId], references: [id])
  items             ImportRunItem[]

  /// One active run per session is enforced by a partial unique index in the migration.
  @@index([importSessionId, kind, createdAt])
  @@index([branchId, createdAt])
  @@index([status, createdAt])
}

model ImportRunItem {
  id              String              @id @default(cuid())
  importRunId     String
  importRowId     String?
  evaluationId    String?
  ordinal         Int
  itemKey         String
  kind            ImportRunItemKind
  idempotencyKey  String              @unique
  requestHash     String
  status          ImportRunItemStatus @default(QUEUED)
  attemptCount    Int                 @default(0)
  availableAt     DateTime            @default(now())
  leaseToken      String?             @unique
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  payload         Json?
  result          Json?
  error           Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  run        ImportRun            @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  row        ImportRow?           @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  evaluation ImportRowEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@unique([importRunId, itemKey])
  @@unique([importRunId, ordinal])
  @@index([importRunId, status, availableAt])
  @@index([status, leaseExpiresAt])
}

model ImportRecipe {
  id                        String           @id @default(cuid())
  organizationId            String
  branchId                  String?
  createdByUserId           String
  name                      String
  revision                  Int              @default(1)
