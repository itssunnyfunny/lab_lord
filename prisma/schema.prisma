generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String         @id @default(cuid())
  clerkId                String?        @unique
  email                  String         @unique
  name                   String?
  phone                  String?
  timezone               String         @default("Asia/Kolkata")
  locale                 String         @default("en-IN")
  dateFormat             String         @default("dd MMM yyyy")
  themePreference        String         @default("dark")
  densityPreference      String         @default("comfortable")
  defaultMessageLanguage String         @default("en")
  defaultLandingPage     String         @default("org")
  createdAt              DateTime       @default(now())
  organizations          Organization[]
  staff                  Staff[]
  auditLogs              AuditLog[]
  importSessionsUploaded ImportSession[] @relation("ImportSessionUploadedBy")
  importCommits          ImportCommit[]  @relation("ImportCommitCommittedBy")
  ownerTrialGrant        OwnerTrialGrant?
}

model Organization {
  id                    String                    @id @default(cuid())
  name                  String
  ownerId               String
  businessType          String?
  legalName             String?
  contactEmail          String?
  contactPhone          String?
  address               String?
  timezone              String                    @default("Asia/Kolkata")
  currency              String                    @default("INR")
  weekStartsOn          Int                       @default(1)
  paymentGraceDays      Int                       @default(0)
  selectedPostTrialPlan SaasPlan?
  billingModelVersion   BillingModelVersion       @default(LEGACY)
  billingMutationSequence Int                     @default(0)
  billingMutationLeaseToken String?
  billingMutationLeaseUntil DateTime?
  createdAt             DateTime                  @default(now())
  branches              Branch[]
  subscription          OrganizationSubscription? @relation("OrganizationCurrentSubscription")
  pendingSubscriptionReplacement OrganizationSubscription? @relation("OrganizationPendingSubscriptionReplacement")
  subscriptions         OrganizationSubscription[] @relation("OrganizationSubscriptionOwner")
  subscriptionHistory   OrganizationSubscriptionHistory[]
  razorpayWebhookEvents RazorpayWebhookEvent[]
  ownerTrialGrant       OwnerTrialGrant?
  billingChanges        OrganizationBillingChange[]
  offerGrants           OrganizationOfferGrant[]
  subscriptionInvoices  OrganizationSubscriptionInvoice[]
  owner                 User                      @relation(fields: [ownerId], references: [id])
}

model Branch {
  id                     String           @id @default(cuid())
  organizationId         String
  name                   String
  city                   String?
  address                String?
  contactPhone           String?
  openingTime            String?
  closingTime            String?
  defaultFee             Int?             @default(0)
  defaultAdmissionFee    Int?             @default(0)
  defaultMessageLanguage String           @default("en")
  reminderTone           String           @default("polite")
  aiEnabled              Boolean          @default(true)
  createdAt              DateTime         @default(now())
  lastDataChange         DateTime         @default(now())
  aiLastCalledAt         DateTime?
  aiStatus               BranchAIStatus   @default(IDLE)
  billingStatus          BranchBillingStatus @default(ACTIVE)
  billingActivatedAt     DateTime?
  billingArchivedAt      DateTime?
  organization           Organization     @relation(fields: [organizationId], references: [id])
  aiReports              BranchAIReport[]
  messageDrafts          MessageDraft[]
  multiShifts            MultiShift[]
  payments               Payment[]
  seats                  Seat[]
  shifts                 Shift[]
  staff                  Staff[]
  staffInvites           StaffInvite[]
  students               Student[]
  auditLogs              AuditLog[]
  importSessions         ImportSession[]
  billingChanges         OrganizationBillingChange[]
}

model Student {
  id              String           @id @default(cuid())
  branchId        String
  name            String
  phone           String?
  status          StudentStatus    @default(ACTIVE)
  joinedAt        DateTime         @default(now())
  billingStartAt  DateTime?
  monthlyFee      Int              @default(0)
  feeLinkedShiftId String?
  feeLinkedMultiShiftId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messageDrafts   MessageDraft[]
  payments        Payment[]
  seatAllocations SeatAllocation[]
  branch          Branch           @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([branchId, billingStartAt])
  @@index([feeLinkedShiftId])
  @@index([feeLinkedMultiShiftId])
}

model Seat {
  id              String           @id @default(cuid())
  branchId        String
  label           String
  createdAt       DateTime         @default(now())
  branch          Branch           @relation(fields: [branchId], references: [id])
  seatAllocations SeatAllocation[]

  @@unique([branchId, label])
  @@index([branchId])
}

model Shift {
  id                   String                @id @default(cuid())
  branchId             String
  name                 String
  startTime            String?
  endTime              String?
  price                Int                   @default(0)
  isReserved           Boolean               @default(false)
  status               ShiftStatus           @default(ACTIVE)
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  seatAllocations      SeatAllocation[]
  multiShiftComponents MultiShiftComponent[]
  branch               Branch                @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([branchId, status])
}

model MultiShift {
  id          String                @id @default(cuid())
  branchId    String
  name        String
  price       Int                   @default(0)
  createdAt   DateTime              @default(now())
  branch      Branch                @relation(fields: [branchId], references: [id])
  components  MultiShiftComponent[]
  allocations SeatAllocation[]

  @@unique([branchId, name])
  @@index([branchId])
}

model MultiShiftComponent {
  id           String     @id @default(cuid())
  multiShiftId String
  shiftId      String
  order        Int        @default(0)
  multiShift   MultiShift @relation(fields: [multiShiftId], references: [id], onDelete: Cascade)
  shift        Shift      @relation(fields: [shiftId], references: [id])

  @@unique([multiShiftId, shiftId])
}

model SeatAllocation {
  id           String      @id @default(cuid())
  seatId       String
  studentId    String
  shiftId      String
  multiShiftId String?
  startDate    DateTime    @default(now())
  endDate      DateTime?
  seat         Seat        @relation(fields: [seatId], references: [id])
  shift        Shift       @relation(fields: [shiftId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
  multiShift   MultiShift? @relation(fields: [multiShiftId], references: [id])

  @@index([seatId, shiftId])
  @@index([studentId])
  @@index([multiShiftId])
}

model Payment {
  id            String          @id @default(cuid())
  branchId      String
  studentId     String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  amount        Int
  status        PaymentStatus   @default(DUE)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  referenceId   String?
  type          PaymentType     @default(MONTHLY)
  createdAt     DateTime        @default(now())
  branch        Branch          @relation(fields: [branchId], references: [id])
  student       Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, periodStart])
  @@index([branchId, dueDate])
}

model Staff {
  id        String    @id @default(cuid())
  userId    String
  branchId  String
  role      StaffRole
  createdAt DateTime  @default(now())
  branch    Branch    @relation(fields: [branchId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  permissionOverrides StaffPermissionOverride[]

  @@unique([userId, branchId])
  @@index([branchId])
}

model StaffPermissionOverride {
  id        String                @id @default(cuid())
  staffId   String
  action    StaffPermissionAction
  allowed   Boolean
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  staff     Staff                 @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, action])
  @@index([staffId])
}

model StaffInvite {
  id         String    @id @default(cuid())
  branchId   String
  role       StaffRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  branch     Branch    @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([expiresAt])
}

model BranchAIReport {
  id        String   @id @default(cuid())
  branchId  String
  data      Json
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
}

model MessageDraft {
  id        String   @id @default(cuid())
  branchId  String
  studentId String?
  action    String
  language  String   @default("en")
  message   String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])

  @@index([branchId, studentId])
}

model ImportSession {
  id               String              @id @default(cuid())
  branchId          String
  uploadedByUserId  String
  sourceType        ImportSourceType
  fileName          String?
  fileMeta          Json?
  status            ImportSessionStatus @default(UPLOADED)
  mapping           Json?
  summary           Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  branch            Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  uploadedBy        User                @relation("ImportSessionUploadedBy", fields: [uploadedByUserId], references: [id])
  rows              ImportRow[]
  questions         ImportQuestion[]
  commits           ImportCommit[]

  @@index([branchId])
  @@index([uploadedByUserId])
  @@index([branchId, createdAt])
}

model ImportRow {
  id               String          @id @default(cuid())
  importSessionId  String
  rowNumber        Int
  rawData          Json
  mappedData       Json?
  normalizedData   Json?
  status           ImportRowStatus @default(NEEDS_REVIEW)
  issues           Json?
  warnings         Json?
  confidence       Int?
  skipped          Boolean         @default(false)
  createdEntityIds Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  session          ImportSession   @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@index([importSessionId])
  @@index([status])
}

model ImportQuestion {
  id              String               @id @default(cuid())
  importSessionId String
  rowId           String?
  field           String?
  question        String
  options         Json?
  answer          Json?
  status          ImportQuestionStatus @default(OPEN)
  createdAt       DateTime             @default(now())
  answeredAt      DateTime?

  session         ImportSession        @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@index([importSessionId])
  @@index([status])
}

model ImportCommit {
  id                String             @id @default(cuid())
  importSessionId   String
  committedByUserId String
  status            ImportCommitStatus
  summary           Json
  errors            Json?
  createdAt         DateTime           @default(now())

  session           ImportSession      @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  committedBy       User               @relation("ImportCommitCommittedBy", fields: [committedByUserId], references: [id])

  @@index([importSessionId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  DUE
  PAID
  WAIVED
}

enum StaffRole {
  MANAGER
  STAFF
}

enum StaffPermissionAction {
  MANAGE_BRANCH
  STUDENTS
  SEAT_ALLOCATION
  VIEW_PAYMENTS
  GENERATE_PAYMENTS
  MARK_PAYMENT_PAID
  WAIVE_PAYMENTS
  ANALYTICS
}

enum PaymentType {
  ADMISSION
  MONTHLY
}

enum BranchAIStatus {
  IDLE
  RUNNING
}

enum ImportSourceType {
  CSV
  XLSX
  XLS
  PDF
  PASTED_TABLE
  OTHER
}

enum ImportSessionStatus {
  UPLOADED
  ANALYZING
  NEEDS_MAPPING
  NEEDS_INFO
  VALIDATED
  READY_TO_COMMIT
  COMMITTING
  COMMITTED
  PARTIAL
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  READY
  NEEDS_REVIEW
  BLOCKED
  WARNING
  DUPLICATE
  CONFLICT
  IMPORTED
  FAILED
  SKIPPED
}

enum ImportQuestionStatus {
  OPEN
  ANSWERED
  CANCELLED
}

enum ImportCommitStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model AuditLog {
  id        String      @id @default(cuid())
  branchId  String
  userId    String
  action    AuditAction
  paymentId String
  details   Json
  createdAt DateTime    @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([paymentId])
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum SaasPlan {
  BASIC
  PRO
  AGENT_CONTROL
  CUSTOM
}

enum SaasSubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  PAUSED
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum SaasSubscriptionHistorySource {
  CHECKOUT
  VERIFICATION
  WEBHOOK
  CUSTOMER_CANCELLATION
  SYSTEM
}

enum BillingModelVersion {
  LEGACY
  WORKSPACE_V2
}

enum OwnerTrialSource {
  ONBOARDING
  MIGRATION
}

enum OwnerTrialStatus {
  AVAILABLE
  ACTIVE
  EXPIRED
  REVOKED
}

enum BranchBillingStatus {
  ACTIVE
  PENDING_ACTIVATION
  REMOVAL_SCHEDULED
  ARCHIVED
}

enum ProviderPaymentMethod {
  CARD
  UPI
  EMANDATE
  UNKNOWN
}

enum RazorpayMode {
  TEST
  LIVE
}

enum RazorpayPlanProvisioningStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
}

enum BillingChangeType {
  SUBSCRIPTION_AUTHORIZATION
  PAYMENT_METHOD_REPLACEMENT
  UNSUPPORTED_METHOD_CANCELLATION
  TRIAL_SUBSCRIPTION_UPDATE
  PLAN_UPGRADE
  PLAN_DOWNGRADE
  QUANTITY_INCREASE
  BRANCH_REMOVAL
  BRANCH_REACTIVATION
  CANCELLATION
  LEGACY_TRANSITION
}

enum BillingChangeStatus {
  QUEUED
  PROCESSING
  AWAITING_PAYMENT
  SCHEDULED
  APPLIED
  UNDONE
  FAILED
  SUPERSEDED
}

enum BillingOperationStatus {
  CHECKOUT_OPEN
  VERIFYING
  AWAITING_PROVIDER_CONFIRMATION
  APPLIED
  DECLINED
  ABANDONED
  FAILED
  SCHEDULED
}

enum BillingOfferDiscountType {
  FLAT
  PERCENTAGE
}

enum BillingOfferDurationType {
  SINGLE_USE
  LIMITED_CYCLES
}

enum OrganizationOfferGrantStatus {
  ELIGIBLE
  RESERVED
  REDEEMED
  EXPIRED
  REVOKED
}

model OwnerTrialGrant {
  id              String           @id @default(cuid())
  ownerId         String           @unique
  organizationId  String?          @unique
  source          OwnerTrialSource
  status          OwnerTrialStatus @default(AVAILABLE)
  grantedAt       DateTime         @default(now())
  claimedAt       DateTime?
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  consumedAt      DateTime?
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([trialEndsAt])
}

model SaasRazorpayPlan {
  id                     String       @id @default(cuid())
  providerMode           RazorpayMode
  catalogKey             String
  plan                   SaasPlan
  amount                 Int
  amountSubunits         Int
  currency               String       @default("INR")
  period                 String       @default("monthly")
  interval               Int          @default(1)
  razorpayPlanId         String       @unique
  active                 Boolean      @default(true)
  lastProviderVerifiedAt DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  /// Migration-managed partial unique index
  /// `SaasRazorpayPlan_one_active_per_mode_plan_key` guarantees that only one
  /// mapping is active for each provider mode and SaaS plan.
  @@unique([plan, razorpayPlanId])
  @@index([providerMode, plan, active])
  @@index([providerMode, catalogKey])
  @@index([providerMode, razorpayPlanId])
}

model BillingDatabaseIdentity {
  id        Int      @id
  identity  String   @unique @db.Uuid
  createdAt DateTime @default(now())
}

model RazorpayPlanProvisioning {
  id             String                           @id @default(cuid())
  catalogKey     String                           @unique
  providerMode   RazorpayMode
  plan           SaasPlan
  amount         Int
  amountSubunits Int
  currency       String
  period         String
  interval       Int
  status         RazorpayPlanProvisioningStatus   @default(PENDING)
  leaseToken     String?
  leaseUntil     DateTime?
  attemptCount   Int                              @default(0)
  razorpayPlanId String?
  lastError      String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  @@index([providerMode, plan, status])
  @@index([status, leaseUntil])
}

model BillingOffer {
  id                 String                   @id @default(cuid())
  providerMode       RazorpayMode
  name               String
  plan               SaasPlan
  razorpayOfferId    String                   @unique
  discountType       BillingOfferDiscountType
  discountValue      Int
  durationType       BillingOfferDurationType
  durationCycles     Int                      @default(1)
  priority           Int                      @default(0)
  active             Boolean                  @default(true)
  validFrom          DateTime?
  validUntil         DateTime?
  isCompositeStack   Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  subscriptions      OrganizationSubscription[]
  grants             OrganizationOfferGrant[]

  @@index([providerMode, plan, active])
  @@index([providerMode, razorpayOfferId])
}

model OrganizationOfferGrant {
  id                 String                       @id @default(cuid())
  organizationId     String
  billingOfferId     String
  status             OrganizationOfferGrantStatus @default(ELIGIBLE)
  eligibleFrom       DateTime?
  eligibleUntil      DateTime?
  reservedAt         DateTime?
  redeemedAt         DateTime?
  subscriptionId     String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingOffer       BillingOffer                 @relation(fields: [billingOfferId], references: [id])

  @@unique([organizationId, billingOfferId])
  @@index([organizationId, status])
}

model OrganizationSubscription {
  id                     String                 @id @default(cuid())
  organizationId         String
  currentOrganizationId  String?                @unique
  pendingReplacementOrganizationId String?       @unique
  replacesSubscriptionId String?
  providerMode           RazorpayMode
  plan                   SaasPlan
  amount                 Int
  amountSubunits         Int
  currency               String                 @default("INR")
  period                 String                 @default("monthly")
  interval               Int                    @default(1)
  totalCount             Int
  quantity               Int                    @default(1)
  razorpayPlanId         String
  razorpaySubscriptionId String                 @unique
  razorpayCustomerId     String?
  status                 SaasSubscriptionStatus @default(CREATED)
  authPaymentId          String?                @unique
  providerStartAt        DateTime?
  authorizationExpiresAt DateTime?
  providerPaymentMethod  ProviderPaymentMethod  @default(UNKNOWN)
  paidThrough            DateTime?
  lastConfirmedInvoiceId String?
  lastConfirmedPaymentId String?
  lastPaymentConfirmedAt DateTime?
  authorizationLapsedAt  DateTime?
  billingOfferId         String?
  lastReconciledAt       DateTime?
  currentStart           DateTime?
  currentEnd             DateTime?
  chargeAt               DateTime?
  endedAt                DateTime?
  cancelAtCycleEnd        Boolean                @default(false)
  cancellationRequestedAt DateTime?
  cancellationScheduledAt DateTime?
  cancelledAt            DateTime?
  createdByUserId        String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization           @relation("OrganizationSubscriptionOwner", fields: [organizationId], references: [id])
  currentForOrganization Organization?          @relation("OrganizationCurrentSubscription", fields: [currentOrganizationId], references: [id], onDelete: SetNull)
  pendingReplacementForOrganization Organization? @relation("OrganizationPendingSubscriptionReplacement", fields: [pendingReplacementOrganizationId], references: [id], onDelete: SetNull)
  replacesSubscription   OrganizationSubscription? @relation("OrganizationSubscriptionReplacementLineage", fields: [replacesSubscriptionId], references: [id], onDelete: SetNull)
  replacementSubscriptions OrganizationSubscription[] @relation("OrganizationSubscriptionReplacementLineage")
  billingOffer           BillingOffer?           @relation(fields: [billingOfferId], references: [id])
  webhookEvents          RazorpayWebhookEvent[]
  history                OrganizationSubscriptionHistory[]
  billingChanges         OrganizationBillingChange[] @relation("BillingChangeSourceSubscription")
  replacementBillingChange OrganizationBillingChange? @relation("BillingChangeReplacementSubscription")
  invoices               OrganizationSubscriptionInvoice[]

  @@index([providerMode, status])
  @@index([providerMode, plan])
  @@index([providerMode, razorpaySubscriptionId])
  @@index([organizationId, createdAt])
  @@index([replacesSubscriptionId])
}

model OrganizationBillingChange {
  id                         String                   @id @default(cuid())
  organizationId             String
  organizationSubscriptionId String?
  replacementSubscriptionId  String?                  @unique
  branchId                   String?
  sequence                   Int
  idempotencyKey             String                   @unique
  type                       BillingChangeType
  status                     BillingChangeStatus      @default(QUEUED)
  operationStatus            BillingOperationStatus   @default(AWAITING_PROVIDER_CONFIRMATION)
  fromPlan                   SaasPlan?
  toPlan                     SaasPlan?
  fromQuantity               Int?
  toQuantity                 Int?
  effectiveAt                DateTime?
  undoCutoffAt               DateTime?
  providerInvoiceId          String?
  providerPaymentId          String?
  attemptCount               Int                      @default(0)
  processingStartedAt        DateTime?
  appliedAt                  DateTime?
  undoneAt                   DateTime?
  failedAt                   DateTime?
  lastError                  String?
  returnPath                 String?
  confirmationDeadlineAt     DateTime?
  failureCategory            String?
  failureCode                String?
  checkoutOpenedAt           DateTime?
  verificationStartedAt      DateTime?
  providerConfirmedAt        DateTime?
  accessGrantedAt            DateTime?
  accessRevokedAt            DateTime?
  accessGraceEndsAt          DateTime?
  abandonedAt                DateTime?
  declinedAt                 DateTime?
  resolvedAt                 DateTime?
  createdByUserId            String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  organization               Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSubscription   OrganizationSubscription? @relation("BillingChangeSourceSubscription", fields: [organizationSubscriptionId], references: [id], onDelete: SetNull)
  replacementSubscription    OrganizationSubscription? @relation("BillingChangeReplacementSubscription", fields: [replacementSubscriptionId], references: [id], onDelete: SetNull)
  branch                     Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sequence])
  @@index([organizationId, status, sequence])
  @@index([organizationId, operationStatus, sequence])
  @@index([undoCutoffAt, status])
}

model OrganizationSubscriptionInvoice {
  id                         String                    @id @default(cuid())
  organizationId             String
  organizationSubscriptionId String?
  razorpayInvoiceId          String                    @unique
  razorpayPaymentId          String?                   @unique
  status                     String
  amountSubunits             Int
  amountPaidSubunits         Int                       @default(0)
  amountDueSubunits          Int                       @default(0)
  currency                   String                    @default("INR")
  paymentMethod              ProviderPaymentMethod     @default(UNKNOWN)
  periodStart                DateTime?
  periodEnd                  DateTime?
  issuedAt                   DateTime?
  paidAt                     DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSubscription   OrganizationSubscription? @relation(fields: [organizationSubscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationSubscriptionId, createdAt])
}

model OrganizationSubscriptionHistory {
  id                         String                        @id @default(cuid())
  organizationId             String
  organizationSubscriptionId String?
  razorpaySubscriptionId     String
  razorpayPaymentId          String?
  plan                       SaasPlan
  fromStatus                 SaasSubscriptionStatus?
  toStatus                   SaasSubscriptionStatus
  source                     SaasSubscriptionHistorySource
  event                      String?
  amountSubunits             Int
  quantity                   Int                           @default(1)
  unitAmountSubunits         Int                           @default(0)
  totalAmountSubunits        Int                           @default(0)
  paidThrough                DateTime?
  dedupeKey                  String?                       @unique
  currency                   String
  createdAt                  DateTime                      @default(now())
  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationSubscription   OrganizationSubscription?     @relation(fields: [organizationSubscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationSubscriptionId, createdAt])
  @@index([razorpaySubscriptionId])
}

model RazorpayWebhookEvent {
  id                         String                    @id @default(cuid())
  eventId                    String                    @unique
  event                      String
  organizationId             String?
  organizationSubscriptionId String?
  razorpayPaymentId          String?
  razorpaySubscriptionId     String?
  payloadHash                String
  receivedAt                 DateTime                  @default(now())
  processedAt                DateTime?
  processingError            String?
  organization               Organization?             @relation(fields: [organizationId], references: [id])
  organizationSubscription   OrganizationSubscription? @relation(fields: [organizationSubscriptionId], references: [id])

  @@index([organizationId])
  @@index([organizationSubscriptionId])
  @@index([razorpayPaymentId])
  @@index([razorpaySubscriptionId])
}

enum AuditAction {
  PAYMENT_MARKED_PAID
  PAYMENT_WAIVED
}
