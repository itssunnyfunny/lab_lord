# Public configuration-name reference only. Never place real credentials here.
# Keep all WhatsApp capabilities held until the reviewed runbook gates are met.

# Meta WhatsApp server-only configuration
META_WHATSAPP_MODE=TEST
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_BUSINESS_ID=
META_SYSTEM_USER_ID=
META_SYSTEM_USER_ACCESS_TOKEN=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Independent fail-closed release controls
WHATSAPP_INTEGRATION_ENABLED=false
WHATSAPP_META_ONBOARDING_WRITES_ENABLED=false
WHATSAPP_META_TEMPLATE_WRITES_ENABLED=false
WHATSAPP_META_MESSAGE_WRITES_ENABLED=false
WHATSAPP_AUTOMATION_PLANNER_ENABLED=false
WHATSAPP_WEBHOOK_INGEST_ENABLED=false
WHATSAPP_LIVE_CANARY_ORG_IDS=
WHATSAPP_LIVE_DELIVERY_CANARY_ORG_IDS=

# Operator-reviewed estimated INR Utility rate card. Leave blank while held.
# Rate is integer INR micros per eligible template message; effective time is UTC.
WHATSAPP_UTILITY_RATE_MICROS_INR=
WHATSAPP_RATE_CARD_VERSION=
WHATSAPP_RATE_CARD_EFFECTIVE_AT=

# Shared bearer for machine-authenticated cron routes; provide through secrets.
CRON_SECRET=
